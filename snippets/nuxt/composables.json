{
  "useAppConfig": {
    "prefix": [
      "useAppConfig"
    ],
    "body": [
      "const ${1:appConfig} = useAppConfig();"
    ],
    "description": "Read reactive public application configuration.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-app-config"
  },
  "useAsyncData": {
    "prefix": [
      "useAsyncData"
    ],
    "body": [
      "const { data, status, error, refresh } = await useAsyncData(",
      "    '${1:example}',",
      "    () => \\$fetch('${2:/api/hello}')",
      ");"
    ],
    "description": "Fetch keyed data shared between server rendering and hydration.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-async-data"
  },
  "useCookie": {
    "prefix": [
      "useCookie"
    ],
    "body": [
      "const ${1:cookie} = useCookie('${2:cookie-name}');"
    ],
    "description": "Read or write an SSR-aware cookie ref.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-cookie"
  },
  "useError": {
    "prefix": [
      "useError"
    ],
    "body": [
      "const ${1:error} = useError();"
    ],
    "description": "Read the current global Nuxt error.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-error"
  },
  "useFetch": {
    "prefix": [
      "useFetch"
    ],
    "body": [
      "const { data, status, error, refresh } = await useFetch('${1:/api/hello}');"
    ],
    "description": "Fetch SSR-safe reactive data with typed request options.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-fetch"
  },
  "onRequest": {
    "prefix": "onRequest",
    "body": [
      "onRequest({ request, options }) {",
      "    $1",
      "}"
    ],
    "description": "onRequest"
  },
  "onRequestError": {
    "prefix": "onRequestError",
    "body": [
      "onRequestError({ request, options, error }) {",
      "    $1",
      "}"
    ],
    "description": "onRequestError"
  },
  "onResponse": {
    "prefix": "onResponse",
    "body": [
      "onResponse({ request, response, options }) {",
      "    $1",
      "}"
    ],
    "description": "onResponse"
  },
  "onResponseError": {
    "prefix": "onResponseError",
    "body": [
      "onResponseError({ request, response, options }) {",
      "    $1",
      "}"
    ],
    "description": "onResponseError"
  },
  "useHeadSafe": {
    "prefix": [
      "useHeadSafe"
    ],
    "body": [
      "useHeadSafe({",
      "    title: '${1:Page title}'",
      "});"
    ],
    "description": "Set document metadata using the restricted safe attribute set.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-head-safe"
  },
  "useHead": {
    "prefix": [
      "useHead"
    ],
    "body": [
      "useHead({",
      "    title: '${1:Page title}'",
      "});"
    ],
    "description": "Set reactive document metadata.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-head"
  },
  "useHydration": {
    "prefix": [
      "useHydration"
    ],
    "body": [
      "useHydration(",
      "    '${1:hydration-key}',",
      "    () => ${2:null},",
      "    (${3:value}) => {",
      "        ${0:// Restore application state from the hydrated value.}",
      "    }",
      ");"
    ],
    "description": "Transfer keyed plugin state from server to client using getter and setter callbacks.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-hydration"
  },
  "useLazyAsyncData": {
    "prefix": [
      "useLazyAsyncData"
    ],
    "body": [
      "const { data, status, error, refresh } = await useLazyAsyncData(",
      "    '${1:example}',",
      "    () => \\$fetch('${2:/api/hello}')",
      ");"
    ],
    "description": "Start keyed data loading without blocking navigation.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-lazy-async-data"
  },
  "useLazyFetch": {
    "prefix": [
      "useLazyFetch"
    ],
    "body": [
      "const { data, status, error, refresh } = await useLazyFetch('${1:/api/hello}');"
    ],
    "description": "Fetch data without blocking navigation.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-lazy-fetch"
  },
  "useNuxtApp": {
    "prefix": [
      "useNuxtApp"
    ],
    "body": [
      "const ${1:nuxtApp} = useNuxtApp();"
    ],
    "description": "Access the Nuxt application context and injected services.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-nuxt-app"
  },
  "useNuxtData": {
    "prefix": [
      "useNuxtData"
    ],
    "body": [
      "const { data: ${1:cachedData} } = useNuxtData('${2:example}');"
    ],
    "description": "Read cached async data by key.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-nuxt-data"
  },
  "useRequestEvent": {
    "prefix": [
      "useRequestEvent"
    ],
    "body": [
