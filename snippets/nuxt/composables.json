  },
  "useRuntimeHook": {
    "prefix": [
      "useRuntimeHook"
    ],
    "body": [
      "useRuntimeHook('${1:app:mounted}', () => {",
      "    ${0:// Handle the application hook here.}",
      "});"
    ],
    "description": "Register a runtime hook with automatic scope disposal; requires Nuxt 3.14+.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-runtime-hook",
