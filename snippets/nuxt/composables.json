    ],
    "description": "Read one SSR request header; undefined in the browser.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-request-header"
  },
  "useResponseHeader": {
    "prefix": [
      "useResponseHeader"
    ],
    "body": [
