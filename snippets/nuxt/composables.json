    ],
    "description": "Access the SSR request event; undefined in the browser.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-request-event"
  },
  "useRequestHeaders": {
    "prefix": [
      "useRequestHeaders"
    ],
    "body": [
      "const ${1:headers} = useRequestHeaders(['${2:authorization}']);"
    ],
    "description": "Read selected SSR request headers; empty in the browser.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-request-headers"
  },
  "useRequestURL": {
    "prefix": [
      "useRequestURL"
    ],
    "body": [
      "const ${1:url} = useRequestURL();"
    ],
    "description": "Read the current request URL in server or browser context.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-request-url"
  },
  "useRoute": {
    "prefix": [
      "useRoute"
    ],
    "body": [
      "const ${1:route} = useRoute();"
    ],
    "description": "Read Nuxt’s synchronized current route.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-route"
  },
  "useRouter": {
    "prefix": [
      "useRouter"
    ],
    "body": [
      "const ${1:router} = useRouter();"
    ],
    "description": "Access the application router.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-router"
  },
  "useRuntimeConfig": {
    "prefix": [
      "useRuntimeConfig"
    ],
    "body": [
      "const ${1:config} = useRuntimeConfig();"
    ],
    "description": "Read runtime configuration; private values are server-only.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-runtime-config"
  },
  "useSeoMeta": {
    "prefix": [
      "useSeoMeta"
    ],
    "body": [
      "useSeoMeta({",
      "    title: '${1:Page title}',",
      "    description: '${2:Page description}'",
      "});"
    ],
    "description": "Set typed reactive SEO metadata.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-seo-meta"
  },
  "useServerSeoMeta": {
    "prefix": [
      "useServerSeoMeta"
    ],
    "body": [
      "useServerSeoMeta({",
      "    title: '${1:Page title}',",
      "    description: '${2:Page description}'",
      "});"
    ],
    "description": "Set SEO metadata during server rendering.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-server-seo-meta"
  },
  "useState": {
    "prefix": [
      "useState"
    ],
    "body": [
      "const ${1:state} = useState('${2:state-key}', () => ${3:null});"
    ],
    "description": "Create keyed state shared safely across SSR and hydration.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/use-state"
  },
  "createUseAsyncData": {
    "prefix": [
      "createUseAsyncData"
    ],
    "body": [
      "export const ${1:useCustomAsyncData} = createUseAsyncData({",
      "    lazy: ${2:true}",
      "});"
    ],
    "description": "Export a configured async-data composable from the composables directory; requires Nuxt 4.4+.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/create-use-async-data",
    "minimumNuxtVersion": "4.4.0"
  },
  "createUseFetch": {
    "prefix": [
      "createUseFetch"
    ],
    "body": [
      "export const ${1:useAPI} = createUseFetch({",
      "    baseURL: '${2:https://example.com}'",
      "});"
    ],
    "description": "Export a configured fetch composable from the composables directory; requires Nuxt 4.4+.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/create-use-fetch",
    "minimumNuxtVersion": "4.4.0"
  },
  "onPrehydrate": {
    "prefix": [
      "onPrehydrate"
    ],
    "body": [
      "onPrehydrate((${1:element}) => {",
      "    ${0:// Use only browser globals and values inside this callback.}",
      "});"
    ],
    "description": "Run serialized browser code before hydration; the callback must be self-contained.",
    "documentation": "https://nuxt.com/docs/4.x/api/composables/on-prehydrate",
    "minimumNuxtVersion": "3.12.0"
  },
  "useAnnouncer": {
    "prefix": [
